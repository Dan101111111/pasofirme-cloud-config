# ==============================================================================
# PasoFirme: Plantilla de variables de entorno (Valores ilustrativos de ejemplo)
# ==============================================================================
# Copie este archivo como .env y defina sus contraseñas locales seguras.
# El archivo .env real está excluido por .gitignore y NUNCA debe versionarse en Git.

# Puerto en el host (127.0.0.1). Se unifica en 3308 porque 3307 está ocupado por contenedor preexistente
MYSQL_PORT=3308

# Nombre de la base de datos de negocio
MYSQL_DATABASE=zapatos_db

# Usuario de la aplicación (solo debe acceder a su propia base de datos)
MYSQL_USER=zapatos_app

# Contraseña del usuario de aplicación (ejemplo ilustrativo - cambie en .env)
MYSQL_PASSWORD=Cambiar_Contrasena_App_123!

# Contraseña del usuario root de MySQL (ejemplo ilustrativo - cambie en .env)
MYSQL_ROOT_PASSWORD=Cambiar_Contrasena_Root_Segura_456!

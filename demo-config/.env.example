# ==============================================================================
# Variables de entorno para PasoFirme Config Demo (Spring Cloud Config)
# ==============================================================================

# URI HTTPS obligatoria del repositorio Git remoto de configuraciones (pasofirme-config-repo)
CONFIG_GIT_URI=https://github.com/Dan101111111/pasofirme-config-repo.git

# Perfil de configuracion de negocio para los clientes (dev o prod)
# dev  = Catalogo urbano/deportivo, descuento 10%, entrega 48h
# prod = Catalogo alta gama, descuento 35%, entrega nacional express 24h
DEMO_PROFILE=dev


			"item": [
				{
					"name": "1.1 Health Check - Config Server",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code es 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Config Server reporta estado UP', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.status).to.eql('UP');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:18888/actuator/health",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "18888",
							"path": [
								"actuator",
								"health"
							]
						}
					},
					"response": []
				},

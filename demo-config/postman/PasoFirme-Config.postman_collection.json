									"});",
									"pm.test('Devuelve nombre, label y version Git no vacia', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.name).to.eql('catalogo-demo');",
									"    pm.expect(json.label).to.eql('main');",
									"    pm.expect(json.version).to.not.be.empty;",
									"    pm.expect(json.propertySources).to.be.an('array').that.is.not.empty;",
									"});"
								],

              "raw": "{{baseUrl}}/api/zapatos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "zapatos"]
            },
            "description": "Constata que el zapato original id1 (Bata) permanece intacto y que se crearon los nuevos registros correspondientes."
          },

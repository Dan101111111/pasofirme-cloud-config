  "item": [
    {
      "name": "01 - Flujo Principal de Negocio",
      "item": [
        {
          "name": "01 - GET Inicial Zapatos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Reiniciar variables transitorias al iniciar la ejecucion de la coleccion",
                  "pm.collectionVariables.set(\"id1\", \"\");",
                  "pm.collectionVariables.set(\"id2\", \"\");",
                  "pm.collectionVariables.set(\"idOpcional\", \"\");",
                  "pm.collectionVariables.set(\"idNuevo\", \"\");",
                  "pm.collectionVariables.set(\"preRechazos\", \"[]\");",
                  "pm.collectionVariables.set(\"countPreValidacion\", \"0\");",
                  "pm.collectionVariables.set(\"initialIds\", \"[]\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respuesta es un arreglo JSON y guarda IDs iniciales\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(Array.isArray(data)).to.be.true;",
                  "    var initialIds = data.map(function(item) { return item.id; });",
                  "    pm.collectionVariables.set(\"initialIds\", JSON.stringify(initialIds));",
                  "    pm.collectionVariables.set(\"countPreValidacion\", data.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/zapatos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "zapatos"]
            },
            "description": "Consulta inicial de la colección. Comprueba respuesta 200 y formato de arreglo JSON sin exigir base de datos vacía."
          },
          "response": []
        },
        {
          "name": "02 - POST Zapato 1 (Bata)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"ID es entero positivo y los datos coinciden exactamente\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.id).to.be.a('number');",
                  "    pm.expect(res.id).to.be.above(0);",
                  "    pm.expect(Number.isInteger(res.id)).to.be.true;",
                  "    pm.expect(res.marca).to.eql(\"Bata\");",
                  "    pm.expect(res.talla).to.eql(39);",
                  "    pm.expect(Number(res.precio)).to.eql(129900.50);",
                  "    pm.expect(res.fechaIngreso).to.eql(\"2026-10-27\");",
                  "    pm.expect(res.disponible).to.be.true;",
                  "    pm.collectionVariables.set(\"id1\", res.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Bata\",\n  \"talla\": 39,\n  \"precio\": 129900.50,\n  \"fechaIngreso\": \"2026-10-27\",\n  \"disponible\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zapatos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "zapatos"]
            },
            "description": "Registro de primer zapato válido. Almacena id1 para verificaciones posteriores."
          },
          "response": []
        },
        {
          "name": "03 - POST Zapato 2 (Adidas - disponible false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"ID es distinto de id1 y disponible es estrictamente false\", function () {",
                  "    var res = pm.response.json();",
                  "    var id1 = Number(pm.collectionVariables.get(\"id1\"));",
                  "    pm.expect(res.id).to.be.a('number');",
                  "    pm.expect(res.id).to.not.eql(id1);",
                  "    pm.expect(res.marca).to.eql(\"Adidas\");",
                  "    pm.expect(res.talla).to.eql(42);",
                  "    pm.expect(Number(res.precio)).to.eql(249900.00);",
                  "    pm.expect(res.fechaIngreso).to.eql(\"2026-10-26\");",
                  "    pm.expect(res.disponible).to.not.be.null;",
                  "    pm.expect(res.disponible).to.be.false;",
                  "    pm.collectionVariables.set(\"id2\", res.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Adidas\",\n  \"talla\": 42,\n  \"precio\": 249900.00,\n  \"fechaIngreso\": \"2026-10-26\",\n  \"disponible\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zapatos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "zapatos"]
            },
            "description": "Registro de segundo zapato. Comprueba que el valor booleano false se conserve y no mute a null."
          },
          "response": []
        },
        {
          "name": "04 - GET Zapatos (Verificar id1 e id2 y 6 campos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Lista contiene id1 e id2 con exactamente 6 campos por objeto\", function () {",
                  "    var list = pm.response.json();",
                  "    var id1 = Number(pm.collectionVariables.get(\"id1\"));",
                  "    var id2 = Number(pm.collectionVariables.get(\"id2\"));",
                  "",
                  "    var item1 = list.find(function(z) { return z.id === id1; });",
                  "    var item2 = list.find(function(z) { return z.id === id2; });",
                  "",
                  "    pm.expect(item1, \"id1 debe estar presente en el listado\").to.not.be.undefined;",
                  "    pm.expect(item2, \"id2 debe estar presente en el listado\").to.not.be.undefined;",
                  "",
                  "    var expectedKeys = [\"id\", \"marca\", \"talla\", \"precio\", \"fechaIngreso\", \"disponible\"];",
                  "    [item1, item2].forEach(function(item) {",
                  "        var keys = Object.keys(item);",
                  "        pm.expect(keys.length).to.eql(6);",
                  "        expectedKeys.forEach(function(k) {",
                  "            pm.expect(item).to.have.property(k);",
                  "        });",
                  "    });",
                  "",
                  "    pm.collectionVariables.set(\"preRechazos\", JSON.stringify(list));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/zapatos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "zapatos"]
            },
            "description": "Verifica presencia de id1 e id2 y estructura exacta de 6 campos por entidad sin asumir orden ni cantidad fija total."
          },
          "response": []
        }
      ]
    },

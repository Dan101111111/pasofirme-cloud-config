    "name": "PasoFirme",
    "description": "Colección completa de pruebas de contrato y funcionales para el sistema distribuido PasoFirme. Todas las peticiones se realizan a través de la pasarela Gateway (puerto 18080) hacia el microservicio de zapatos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

    {
      "key": "baseUrl",
      "value": "http://localhost:18080",
      "type": "string"
    },
    {
      "key": "id1",
      "value": "",
      "type": "string"
    },
    {
      "key": "id2",
      "value": "",
      "type": "string"
    },
    {
      "key": "idOpcional",

    {
      "name": "04 - Contrato Opcional e Inmutabilidad de ID",
      "item": [
        {
          "name": "09 - POST Campos Opcionales Omitidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Marca válida y los cuatro campos opcionales son null\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.id).to.be.a('number');",
                  "    pm.expect(res.marca).to.eql(\"Puma\");",
                  "    pm.expect(res.talla).to.be.null;",
                  "    pm.expect(res.precio).to.be.null;",
                  "    pm.expect(res.fechaIngreso).to.be.null;",
                  "    pm.expect(res.disponible).to.be.null;",
                  "    pm.collectionVariables.set(\"idOpcional\", res.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Puma\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zapatos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "zapatos"]
            },
            "description": "Demuestra el contrato de campos opcionales: solo 'marca' es obligatorio; los otros cuatro campos se persisten y devuelven como null."
          },
          "response": []
        },
        {
          "name": "10a - POST con ID Recibido en Body (ID Ignorado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"El ID enviado fue ignorado y se asignó un ID autoincremental nuevo\", function () {",
                  "    var res = pm.response.json();",
                  "    var id1 = Number(pm.collectionVariables.get(\"id1\"));",
                  "    pm.expect(res.id).to.be.a('number');",
                  "    pm.expect(res.id).to.not.eql(id1);",
                  "    pm.expect(res.marca).to.eql(\"Reebok Nuevo\");",
                  "    pm.collectionVariables.set(\"idNuevo\", res.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{id1}},\n  \"marca\": \"Reebok Nuevo\",\n  \"talla\": 41,\n  \"precio\": 189000.00,\n  \"fechaIngreso\": \"2026-10-27\",\n  \"disponible\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zapatos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "zapatos"]
            },
            "description": "Envía 'id' en el cuerpo del POST. Comprueba que el servicio ignore el ID recibido y genere uno nuevo por autoincremento."
          },
          "response": []
        },
        {
          "name": "10b - GET Zapatos (Verificar Inmutabilidad de id1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"El registro original con id1 no fue modificado y el nuevo registro existe\", function () {",
                  "    var list = pm.response.json();",
                  "    var id1 = Number(pm.collectionVariables.get(\"id1\"));",
                  "    var idNuevo = Number(pm.collectionVariables.get(\"idNuevo\"));",
                  "    var idOpcional = Number(pm.collectionVariables.get(\"idOpcional\"));",
                  "",
                  "    var original = list.find(function(z) { return z.id === id1; });",
                  "    pm.expect(original, \"El registro original id1 debe existir\").to.not.be.undefined;",
                  "    pm.expect(original.marca).to.eql(\"Bata\");",
                  "    pm.expect(original.talla).to.eql(39);",
                  "    pm.expect(Number(original.precio)).to.eql(129900.50);",
                  "    pm.expect(original.fechaIngreso).to.eql(\"2026-10-27\");",
                  "    pm.expect(original.disponible).to.be.true;",
                  "",
                  "    var nuevo = list.find(function(z) { return z.id === idNuevo; });",
                  "    pm.expect(nuevo, \"El nuevo registro creado debe existir\").to.not.be.undefined;",
                  "    pm.expect(nuevo.marca).to.eql(\"Reebok Nuevo\");",
                  "",
                  "    var opcional = list.find(function(z) { return z.id === idOpcional; });",
                  "    pm.expect(opcional, \"El registro opcional debe existir\").to.not.be.undefined;",
                  "    pm.expect(opcional.marca).to.eql(\"Puma\");",
                  "    pm.expect(opcional.talla).to.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
